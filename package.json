{
  "name": "clinic-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Role-based clinic bookings dashboard (Next.js + Supabase) with permission rules enforced in code and in the database.",
  "author": "EmSoft",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 5180 -H 127.0.0.1",
    "build": "next build",
    "test": "node --import tsx --test tests/*.test.ts",
    "seed:sql": "tsx scripts/make-seed-sql.ts",
    "test:db": "psql -v ON_ERROR_STOP=1 -q -f supabase/tests/rls.test.sql",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
